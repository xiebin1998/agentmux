{
  "productName": "AgentMux",
  "version": "0.2.5",
  "identifier": "com.agentmux.app",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd ../frontend && npm run dev",
    "beforeBuildCommand": "cd ../frontend && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AgentMux",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0MjlFNjU3QjdENzU2MTIKUldRU1Z0ZTNWK1lwWkVYTHI5V1RKWm84bTFqQ25TQ0g3M043NERUa29uK0pQaXlNcVcrcm1TejkK",
      "endpoints": [
        "https://github.com/xiebin1998/agentmux/releases/latest/download/latest.json"
      ]
    }
  }
}
